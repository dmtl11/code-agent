# Public root allowlist. New generated projects stay local by default.
# Add a new project-owned directory here deliberately before committing it.
/*
!/.gitignore
!/README.md
!/README.txt
!/PROJECT_OVERVIEW.txt
!/pyproject.toml
!/run.py
!/src/
!/web/
!/tests/
!/benchmarks/
!/examples/
!/config/
!/docs/
!/.github/

# Local credentials, including backups and per-environment variants.
.env
.env.*
*.env
*.env.*
*.pem
*.key
credentials.json
secrets.json

# Config has exactly one public template. Real values belong in llm.env.
/config/*
!/config/llm.env.example

# Keep public text docs and README illustrations, not generated reports/decks.
/docs/*
!/docs/evaluation.md
!/docs/code-agent-iteration-report.md
!/docs/architecture-slides/
/docs/architecture-slides/*
!/docs/architecture-slides/01-model-routing.png
!/docs/architecture-slides/02-session-design.png
!/docs/architecture-slides/03-memory-context.png
*.docx
*.pptx
*.pdf
~$*

# Generated workspaces and private runtime records, even when nested.
workspace/
*_workspace/
agent_e2e/
video_demo*/
eval_runs/
.code_agent/
.code_agent_build/
/tests/_work/
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.log

# Dependency, build and editor artifacts.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
node_modules/
dist/
build/
*.egg-info/
.coverage
htmlcov/
.DS_Store
Thumbs.db
