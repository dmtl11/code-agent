# Copy this file to config/llm.env and fill in your own key.
# Do not commit config/llm.env.

# Select one provider: deepseek / openai (CloseAI ChatGPT) / claude (CloseAI Claude) / qwen.
CODE_AGENT_PROVIDER=deepseek

# Optional common overrides. Leave blank to use the selected provider's default.
# Provider-specific *_BASE_URL and *_MODEL below take priority over these values.
CODE_AGENT_BASE_URL=
CODE_AGENT_MODEL=
# Claude can use its native Messages protocol or an OpenAI-compatible relay.
# CLOSEAI_PROTOCOL can be set once for both ChatGPT and Claude when they share a relay.
CODE_AGENT_PROTOCOL=
CODE_AGENT_API_KEY=

# Put your CloseAI key here. It is shared by the ChatGPT and Claude dropdown options.
# CloseAI relay key, used by both CloseAI model options.
CLOSEAI_API_KEY=
CLOSEAI_BASE_URL=
# Use separate model IDs so the dropdown can switch between ChatGPT and Claude.
CLOSEAI_OPENAI_MODEL=
CLOSEAI_CLAUDE_MODEL=
CLOSEAI_MODEL=
CLOSEAI_OPENAI_PROTOCOL=
CLOSEAI_CLAUDE_PROTOCOL=
CLOSEAI_PROTOCOL=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
DASHSCOPE_API_KEY=

# Context controls (rough token budget and compact repository map size):
CODE_AGENT_CONTEXT_TOKENS=16000
CODE_AGENT_REPO_MAP_CHARS=6000

# Provider notes:
# - ChatGPT and Claude both use the CloseAI key in this project.
# - For a CloseAI OpenAI-compatible relay, set CLOSEAI_API_KEY, CLOSEAI_BASE_URL,
#   CLOSEAI_OPENAI_MODEL, CLOSEAI_CLAUDE_MODEL, and set both *_PROTOCOL=openai.
# - For a CloseAI Anthropic-compatible Claude relay, set CLOSEAI_CLAUDE_PROTOCOL=anthropic.
# - Qwen uses DashScope's OpenAI-compatible endpoint; DASHSCOPE_API_KEY is also accepted.
