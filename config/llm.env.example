# Copy this file to config/llm.env and fill in your own key.
# Do not commit config/llm.env.

# DeepSeek:
CODE_AGENT_BASE_URL=https://api.deepseek.com/v1
CODE_AGENT_MODEL=deepseek-chat
CODE_AGENT_API_KEY=

# Context controls (rough token budget and compact repository map size):
CODE_AGENT_CONTEXT_TOKENS=16000
CODE_AGENT_REPO_MAP_CHARS=6000

# OpenAI-compatible services also work:
# CODE_AGENT_BASE_URL=https://api.openai.com/v1
# CODE_AGENT_MODEL=gpt-4o-mini
# CODE_AGENT_API_KEY=
